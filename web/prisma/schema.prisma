generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PricingMode {
  PAYG
  SUBSCRIPTION_FLAT
  SUBSCRIPTION_AMORTIZED
}

enum Currency {
  USD
  EUR
}

enum RateMode {
  HOURLY
  DAILY
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  currency         Currency    @default(EUR)
  hourlyRate       Decimal     @default(0) @db.Decimal(10, 2)
  rateMode         RateMode    @default(HOURLY)
  dailyRate        Decimal?    @db.Decimal(10, 2)
  hoursPerDay      Decimal     @default(7) @db.Decimal(4, 1)
  pricingMode      PricingMode @default(PAYG)
  subscriptionCost Decimal?    @db.Decimal(10, 2)
  /// Monthly AI-cost budget in the user's display currency; null = no budget alert.
  budgetAmount     Decimal?    @db.Decimal(10, 2)
  apiKeyHash       String?     @unique
  apiKeyPrefix     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  projects         Project[]

  organizationId    String?
  organization      Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id])
  ownedOrganization Organization? @relation("OrganizationOwner")
}

/// A company-domain team. Membership auto-joins by email domain; each member
/// keeps their own rate/currency/pricing/budget settings and their own
/// private projects — this only adds an admin-visible rollup, it doesn't
/// change Project/Session ownership at all.
model Organization {
  id        String   @id @default(cuid())
  domain    String   @unique
  name      String
  ownerId   String   @unique
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  members   User[]   @relation("OrganizationMembers")
}

model Project {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  clientName String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]

  @@unique([userId, name])
}

model Session {
  id                  String    @id @default(cuid())
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientSessionId     String?   @unique
  gitBranch           String?
  ticketRef           String?
  startedAt           DateTime
  endedAt             DateTime?
  tokensInput         Int       @default(0)
  tokensOutput        Int       @default(0)
  tokensCacheRead     Int       @default(0)
  tokensCacheCreation Int       @default(0)
  estimatedCostUsd    Decimal   @default(0) @db.Decimal(10, 4)
  /// Per-model {input, output, cacheRead, cacheCreation, costUsd} breakdown; null for sessions synced before this field existed.
  modelBreakdown      Json?
  /// null = tracked natively by the collector. "clockify" etc. = imported via web/lib/imports templates.
  source              String?
  /// Groups rows created by one import run, so an import can be undone as a batch.
  importBatchId       String?
  createdAt           DateTime  @default(now())

  // --- Quality / efficiency signals. All nullable: null = collector predates
  // these fields (or the session was imported), never "zero". Counters only,
  // never prompt or tool-output content.
  /// bugfix | feature | refactor | chore | docs | test | other. Derived from gitBranch at ingest unless taskTypeManual.
  taskType            String?
  /// true once edited by hand in the dashboard — ingest then stops re-deriving it.
  taskTypeManual      Boolean   @default(false)
  promptCount         Int?
  editAccepted        Int?
  editRejected        Int?
  toolCalls           Int?
  toolErrors          Int?
  linesAdded          Int?
  linesRemoved        Int?
  commitCount         Int?
  prCount             Int?
  /// Manual 1-5 rating.
  rating              Int?
  ratingComment       String?
  /// Manual: the work was reverted later.
  revertedLater       Boolean?

  // --- Telemetry v2 (collector >= 0.2.0). Same rule: null = not reported.
  claudeCodeVersion   String?
  /// Fingerprint (12 hex chars) of the project's CLAUDE.md when the session ran; never its content.
  claudeMdHash        String?
  claudeMdLines       Int?
  /// Most-used reasoning effort of the main conversation: low | medium | high | xhigh | max.
  effort              String?
  compactionCount     Int?
  /// Largest main-conversation context (input + cache read + cache creation tokens of one request).
  peakContextTokens   Int?
  apiErrorCount       Int?
  planModeCount       Int?
  subagentRuns        Int?
  skillActivations    Int?
  /// The rating picked in Claude Code's own "How is Claude doing?" survey, as reported.
  surveyResponse      String?
  /// Free-form label set by hand (e.g. a prompt style or experiment arm).
  tag                 String?

  // Composite index covers plain projectId lookups too (leftmost prefix),
  // so it replaces the old standalone @@index([projectId]).
  @@index([projectId, startedAt])
  @@index([startedAt])
  @@index([importBatchId])
}
